rules_version = '2';
// SeloNaChipa — named database ai-studio-611c950c-febe-47c1-afff-35dcb0788339.
// Money, roles, KYC, PINs and config are written ONLY by Cloud Functions (Admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function role() { return request.auth.token.role; }
    function admin() { return signedIn() && request.auth.token.admin != null; }
    function adminIn(roles) { return admin() && (request.auth.token.admin == 'super_admin' || request.auth.token.admin in roles); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Public, read before login: welcome adverts, live config, question bank, categories
    match /platformConfig/{id} { allow read: if true; }  // includes guardrails (written only by admin_updateGuardrails)
    match /contentBlocks/{id} {
      allow read: if resource.data.active == true || admin();
      allow write: if adminIn(['moderator']) && request.resource.data.updatedBy == request.auth.uid;
    }
    match /categories/{id} { allow read: if true; allow write: if adminIn(['moderator']); }
    match /securityQuestionBank/{id} { allow read: if true; allow write: if adminIn(['support', 'compliance']); }

    match /users/{uid} {
      allow read: if me(uid) || admin();
      allow update: if me(uid) && onlyChanges(['fullName', 'firstName', 'area', 'landmark', 'language', 'photoUrl', 'coverUrl', 'notificationPrefs', 'emergencyContact',
        'leadConsent', 'leadConsentAt', 'ageBand', 'province', 'district', 'storeName', 'businessTags', 'paymentPrefs']);
      // location / geo are server-owned (location_save geocodes once and keeps the coordinates permanently)
      match /private/{doc} { allow read, write: if false; }
    }
    match /msisdnIndex/{id} { allow read, write: if false; }

    match /stores/{uid} { allow read: if signedIn(); allow write: if me(uid) && role() == 'SELLER'; }
    match /agentLinks/{id} { allow read: if signedIn() && (resource.data.agentUid == request.auth.uid || resource.data.sellerUid == request.auth.uid) || admin(); }

    // Marketing Centre campaigns: written only by campaign_* functions (prices are worked out on the server).
    // SeloNachipa Open Network: partners, credentials, events, ledgers — server-written; Super Admin reads
    // in the back office. Partners use the /api/v1 API, developers the devportal_* functions; neither reads Firestore.
    match /openPartners/{id} { allow read: if admin(); allow write: if false; }
    match /openClients/{id} { allow read, write: if false; }   // secret hashes: never readable
    match /openEvents/{id} { allow read: if admin(); allow write: if false; }
    match /openAudit/{id} { allow read: if admin(); allow write: if false; }
    match /openUsage/{id} { allow read: if admin(); allow write: if false; }
    match /openIdempotency/{id} { allow read, write: if false; }
    match /openRate/{id} { allow read, write: if false; }
    match /openLedger/{pid}/entries/{id} { allow read: if admin(); allow write: if false; }
    match /campaigns/{id} { allow read: if signedIn() && (resource.data.sellerUid == request.auth.uid || admin()); allow write: if false; }
    // Rider safety: SOS alerts and verified rider IDs are server-written.
    // Rider cover: insurer setup and premiums held for the insurer — server-written, back office read only.
    match /riderCover/{id} { allow read: if admin(); allow write: if false; }
    match /riderCoverPremiums/{id} { allow read: if admin(); allow write: if false; }
    match /coverRemittances/{id} { allow read: if admin(); allow write: if false; }
    match /sosAlerts/{id} { allow read: if signedIn() && (resource.data.riderUid == request.auth.uid || admin()); allow write: if false; }
    match /performanceReports/{id} { allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin()); allow write: if false; }
    match /listings/{id} {
      allow read: if resource.data.status == 'live' || (signedIn() && (resource.data.sellerUid == request.auth.uid || resource.data.agentUid == request.auth.uid)) || admin();
      allow update: if signedIn() && (resource.data.sellerUid == request.auth.uid || resource.data.agentUid == request.auth.uid)
        && resource.data.status != 'removed'
        && onlyChanges(['status', 'stock', 'title', 'description', 'priceNgwee', 'tags'])
        && request.resource.data.status in ['live', 'paused', 'draft']
        && (request.resource.data.status != 'live' || resource.data.status != 'draft');
      allow create, delete: if false;
    }
    match /listingEvents/{id} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; }

    match /orders/{id} {
      allow read: if signedIn() && (
        resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid ||
        resource.data.agentUid == request.auth.uid || resource.data.riderUid == request.auth.uid ||
        (role() == 'RIDER' && resource.data.state == 'BROADCASTING' && request.auth.uid in resource.data.notifiedRiders)) || admin();
      allow write: if false;
    }
    // 🔒 Parcels v2 §9: delivery-code state (HMAC only) is never readable or writable by any client, admins included.
    match /orders/{id}/deliveryCode/{doc} { allow read, write: if false; }
    match /orders/{id}/timeline/{e} {
      allow read: if signedIn() && (get(/databases/$(database)/documents/orders/$(id)).data.buyerUid == request.auth.uid
        || get(/databases/$(database)/documents/orders/$(id)).data.sellerUid == request.auth.uid
        || get(/databases/$(database)/documents/orders/$(id)).data.riderUid == request.auth.uid) || admin();
    }

    // Parcels v2: status, fees and escrow are written only by Cloud Functions.
    function parcelParty(p) { return signedIn() && (p.senderUid == request.auth.uid || p.riderUid == request.auth.uid
      || (p.receiver.uid != null && p.receiver.uid == request.auth.uid)); }
    match /parcels/{id} {
      allow read: if parcelParty(resource.data) || admin()
        || (signedIn() && role() == 'RIDER' && resource.data.status == 'AWAITING_RIDER' && request.auth.uid in resource.data.notifiedRiders);
      allow write: if false;
      match /timeline/{e} { allow read: if parcelParty(get(/databases/$(database)/documents/parcels/$(id)).data) || admin(); allow write: if false; }
      // the 4-digit Pickup PIN: the sender only (never the rider, who must be told it at the door)
      match /private/{doc} { allow read: if signedIn() && resource.data.senderUid == request.auth.uid; allow write: if false; }
      match /deliveryCode/{doc} { allow read, write: if false; }
    }
    match /escrow_ledger/{e} { allow read: if adminIn(['finance', 'analyst', 'compliance']); allow write: if false; }
    match /escrow_releases/{e} { allow read, write: if false; }
    match /deliveryCodeAttempts/{e} { allow read: if adminIn(['operations', 'support', 'compliance']); allow write: if false; }
    match /codeLocks/{e} { allow read: if adminIn(['operations', 'compliance']); allow write: if false; }
    match /riderFlags/{uid} { allow read: if adminIn(['operations', 'compliance']); allow write: if false; }
    match /admin_audit_log/{e} { allow read: if adminIn(['compliance', 'analyst', 'finance', 'operations']); allow write: if false; }
    match /opsAlerts/{e} { allow read: if adminIn(['operations', 'support']); allow write: if false; }
    match /riderLocations/{uid} { allow read: if me(uid) || adminIn(['operations']); allow write: if false; }
    match /riderAreas/{uid} { allow read: if me(uid) || admin(); allow write: if false; }
    match /cities/{id} { allow read: if true; allow write: if false; match /neighbourhoods/{n} { allow read: if true; allow write: if false; } }
    // shared platform address store: anyone signed in can search and reuse; only the server creates/dedupes
    match /addresses/{id} { allow read: if signedIn(); allow write: if false; }
    match /geocodeCache/{id} { allow read, write: if false; }
    // ---- Google Maps (v6.5): public store markers, rider positions, server-only caches and metering
    match /stores/{sellerUid} { allow read: if true; allow write: if false; }
    match /riders/{uid} { allow read: if me(uid) || adminIn(['operations']); allow write: if false; }
    match /riderRoutes/{uid} { allow read: if me(uid) || adminIn(['operations']); allow write: if false; }
    match /mapsCache/{id} { allow read, write: if false; }
    match /mapsRate/{id} { allow read, write: if false; }
    match /mapsUsage/{day} { allow read: if adminIn(['finance', 'operations']); allow write: if false;
      match /shards/{s} { allow read: if adminIn(['finance', 'operations']); allow write: if false; } }
    // ---- Beem OTP + SMS (BEEM-OTP-001): Super Admin only; PINs are never stored
    match /otp_logs/{id} { allow read: if adminIn([]); allow write: if false; }
    match /sms_logs/{id} { allow read: if adminIn([]); allow write: if false; }
    match /beem_stats/{day} { allow read: if adminIn([]); allow write: if false;
      match /shards/{s} { allow read: if adminIn([]); allow write: if false; } }
    match /beem_health/{doc=**} { allow read: if adminIn([]); allow write: if false; }
    match /otp_sessions/{m} { allow read, write: if false; }
    match /otp_rate/{k} { allow read, write: if false; }
    // Listing Studio jobs (server-only; sellers see progress on listings/{id}.studio)
    match /studioJobs/{id} { allow read: if adminIn(['moderator', 'operations']); allow write: if false; }
    match /studioUsage/{day} { allow read: if adminIn([]); allow write: if false; }
    match /otp/{msisdn} { allow read, write: if false; }
    match /idIndex/{id} { allow read, write: if false; }
    // Payment receipts: the payer and the party they were issued on behalf of
    match /receipts/{id} { allow read: if (signedIn() && request.auth.uid in resource.data.partyUids) || adminIn(['finance', 'support']); allow write: if false; }
    // saved delivery addresses (a personal shortlist that points at the shared store)
    match /users/{uid}/addresses/{id} {
      allow read, delete: if me(uid);
      allow create, update: if me(uid) && request.resource.data.keys().hasOnly(['nickname', 'label', 'address', 'lat', 'lng', 'cityId', 'addressId', 'isDefault', 'updatedAt'])
        && request.resource.data.lat is number && request.resource.data.lng is number && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 40;
    }
    // support: users create through support_createTicket; they read their own thread; support staff read all
    match /supportTickets/{id} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || adminIn(['support', 'operations']);
      allow write: if false;
      match /messages/{m} {
        allow read: if (signedIn() && get(/databases/$(database)/documents/supportTickets/$(id)).data.uid == request.auth.uid) || adminIn(['support', 'operations']);
        allow write: if false;
      }
    }
    match /escrowLedger/{orderId}/entries/{e} { allow read: if adminIn(['finance', 'analyst']); }
    match /payouts/{id} { allow read: if (signedIn() && resource.data.uid == request.auth.uid) || adminIn(['finance', 'support', 'analyst']); }
    match /withdrawals/{id} { allow read: if (signedIn() && resource.data.uid == request.auth.uid) || adminIn(['finance', 'support']); }
    // Lipila full-balance withdrawals: the owner may read their own requests; status, balances and locks are server-only.
    match /withdrawal_requests/{id} { allow read: if (signedIn() && resource.data.user_id == request.auth.uid) || adminIn(['finance', 'support']); allow write: if false; }
    match /withdrawal_audit_log/{id} { allow read: if (signedIn() && resource.data.user_id == request.auth.uid) || adminIn(['finance', 'support']); allow write: if false; }
    // Lipila webhook store + Transaction Monitor: Super Admin only, written by functions only
    match /lipila_webhook_events/{id} { allow read: if adminIn([]); allow write: if false; }
    match /webhook_idempotency_log/{id} { allow read, write: if false; }
    match /lipila_tx_stats/{day} { allow read: if adminIn([]); allow write: if false;
      match /shards/{s} { allow read: if adminIn([]); allow write: if false; } }
    match /adminRate/{id} { allow read, write: if false; }
    match /adminViewLog/{id} { allow read: if adminIn([]); allow write: if false; }
    match /adminAccessDenied/{id} { allow read: if adminIn([]); allow write: if false; }
    match /insurancePolicies/{id} { allow read: if adminIn(['finance', 'operations']); }
    match /registrationFees/{id} { allow read: if adminIn(['finance', 'compliance']); }

    match /riderWallets/{uid} { allow read: if me(uid) || adminIn(['finance', 'operations', 'support', 'analyst']); allow write: if false; }
    match /sellerStats/{uid} { allow read: if me(uid) || admin(); allow write: if false; }
    match /ledgers/{uid}/entries/{e} { allow read: if me(uid) || adminIn(['finance', 'support']); }
    match /socialFundTransactions/{id} { allow read: if (signedIn() && resource.data.riderUid == request.auth.uid) || adminIn(['finance']); }

    match /zones/{id} { allow read: if signedIn(); allow write: if adminIn(['operations']); }
    match /riderZones/{uid} {
      allow read: if me(uid) || admin();
      allow write: if me(uid) && role() == 'RIDER' && request.resource.data.keys().hasOnly(['activeZoneIds', 'workingHours', 'updatedAt']);
    }
    match /riderPresence/{uid} { allow read: if me(uid) || adminIn(['operations']); }

    match /socialFundClaims/{id} {
      allow create: if signedIn() && role() == 'RIDER' && request.resource.data.riderUid == request.auth.uid && request.resource.data.status == 'PENDING';
      allow read: if (signedIn() && resource.data.riderUid == request.auth.uid) || adminIn(['finance']);
    }
    match /disputes/{id} {
      allow create: if signedIn() && request.resource.data.raisedBy == request.auth.uid && request.resource.data.status == 'OPEN';
      allow read: if (signedIn() && request.auth.uid in resource.data.parties) || adminIn(['support', 'finance']);
    }
    match /incidents/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || adminIn(['operations', 'support']);
    }
    match /chats/{chatId} {
      allow read: if (signedIn() && request.auth.uid in resource.data.participants) || adminIn(['support']);
      match /messages/{m} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || adminIn(['support']);
        allow create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000
          // order chats close an hour after delivery
          && (get(/databases/$(database)/documents/chats/$(chatId)).data.get('closesAt', null) == null
              || request.time < get(/databases/$(database)/documents/chats/$(chatId)).data.closesAt)
          // 🔒 §18: riders may not send anything that looks like a delivery code, or the words code / PIN
          && (get(/databases/$(database)/documents/chats/$(chatId)).data.get('riderUid', '') != request.auth.uid
              || (!request.resource.data.text.matches('.*([0-9][ .-]?){5}.*')
                  && !request.resource.data.text.lower().matches('(.*[^a-z])?(code|codes|pin)([^a-z].*)?')));
      }
    }
    match /notifications/{uid}/items/{n} {
      allow read: if me(uid);
      allow update: if me(uid) && onlyChanges(['readAt']);
    }
    match /reviews/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.buyerUid == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.state == 'DELIVERED';
    }

    // ---------------- v6.1 Infinity Memory: append-only behaviour log and personal collections
    match /behaviourEvents/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['listing_view', 'video_watch', 'like', 'share', 'enquiry_open', 'save', 'skip', 'not_interested',
             'search', 'session_start', 'session_end', 'details_open', 'follow', 'add_to_cart']
        && request.resource.data.ts is number && id.matches('evt_[0-9a-f-]{36}_s[0-9]{2}');
      allow read: if adminIn(['analyst', 'operations', 'support']);
      allow update, delete: if false;
    }
    match /buyerProfiles/{uid} { allow read: if me(uid) || admin(); allow write: if false; }
    match /likes/{uid}/items/{listingId} { allow read: if me(uid) || admin(); allow write: if false; }
    match /wishlists/{uid}/lists/{listId} {
      allow read, delete: if me(uid);
      allow create, update: if me(uid) && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.itemIds is list && request.resource.data.itemIds.size() <= 500;
    }
    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.followerUid == request.auth.uid && id == request.auth.uid + '_' + request.resource.data.sellerUid;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
    }
    match /inbox/{uid}/items/{id} { allow read: if me(uid); allow update: if me(uid) && onlyChanges(['readAt']); }
    match /listingMedia/{id} { allow read: if true; }
    match /algorithmState/{id} { allow read: if admin(); }
    match /cohortMetrics/{id} { allow read: if admin(); }
    match /feedSessions/{id} { allow read: if (signedIn() && resource.data.buyerId == request.auth.uid) || admin(); }
    match /shares/{id} { allow read: if admin(); }
    match /searchStats/{id} { allow read: if signedIn(); }
    match /listingDaily/{id} { allow read: if (signedIn() && resource.data.sellerUid == request.auth.uid) || admin(); }
    match /sellerAudience/{id} { allow read: if (signedIn() && resource.data.sellerUid == request.auth.uid) || admin(); }
    match /adminMetrics/{id} { allow read: if admin(); }
    // v6.2 paid promotions: written only by Cloud Functions after a confirmed mobile money payment
    match /promotions/{id} { allow read: if (signedIn() && resource.data.sellerUid == request.auth.uid) || adminIn(['finance', 'operations', 'moderator', 'analyst']); allow write: if false; }
    match /platformRevenue/{id} { allow read: if adminIn(['finance', 'analyst']); allow write: if false; }
    match /archive/{id} { allow read: if adminIn(['analyst', 'compliance']); }

    // Back office only
    match /kycQueue/{uid} { allow read: if adminIn(['compliance']); }
    match /moderationQueue/{id} { allow read: if adminIn(['moderator']); }
    match /auditLogs/{id} { allow read: if adminIn(['analyst', 'compliance', 'finance']); }
    match /securityEvents/{id} { allow read: if adminIn(['compliance', 'support']); }
    match /admins/{uid} { allow read: if me(uid) || adminIn([]); }
    match /lipilaEvents/{id} { allow read: if adminIn(['finance']); }
    match /reports/{id} { allow read: if admin(); }
  }
}
