// SeloNachipa's Storage paths. The default bucket of mabala-f2d65 is shared with Mabala, so these rules are deployed
// from the Mabala repo (storage.rules, section "SeloNachipa"), never from here. Change both copies together; this
// file is used by the emulator tests. Path prefixes must not overlap Mabala's.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin(roles) { return request.auth != null && request.auth.token.get('admin', null) != null &&
      (request.auth.token.get('admin', null) == 'super_admin' || request.auth.token.get('admin', null) in roles); }

    // KYC: owner uploads, only compliance can read. Images under 5 MB.
    match /kyc/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if admin(['compliance']);
    }
    // Raw listing media before AI processing and scanning
    match /listing-uploads/{uid}/{batch}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.size < 100 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
      allow read: if (request.auth != null && request.auth.uid == uid) || admin(['moderator']);
    }
    // Published, scanned media (written by functions)
    match /listing-media/{path=**} { allow read: if true; }
    // Proof-of-delivery and collection photos
    match /pod/{orderId}/{file} {
      allow create: if request.auth != null && request.auth.token.role == 'RIDER' && file.matches(request.auth.uid + '_.*')
        && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow read: if (request.auth != null && file.matches(request.auth.uid + '_.*')) || admin(['operations', 'support']);
    }
    // Rider portrait, Social Fund claim evidence, incident photos: owner uploads; owner and the reviewing team read
    match /profiles/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null;
    }
    match /claims/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow read: if (request.auth != null && request.auth.uid == uid) || admin(['finance']);
    }
    match /incidents/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow read: if (request.auth != null && request.auth.uid == uid) || admin(['operations', 'support']);
    }
    // Delivery evidence (Safety Centre): rider uploads geotagged photos; rider and operations/support read.
    match /evidence/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid && request.auth.token.role == 'RIDER'
        && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow read: if (request.auth != null && request.auth.uid == uid) || admin(['operations', 'support']);
    }
    // AI Ad Generator source photos (seller only; the function reads them with admin access)
    match /adgen/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    match /content/{path=**} { allow read: if true; allow write: if admin(['moderator']); }
  }
}
