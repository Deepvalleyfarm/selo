# Non-secret production parameters for mabala-f2d65 (firebase deploy reads this file; no API keys here —
# keys live in Secret Manager). Lipila and Beem values match Mabala's production config (apphosting.yaml).

# --- SMS / OTP (Beem is the active provider)
SMS_PROVIDER=beem
SMS_USERNAME=
SMS_SENDER_ID=SeloNaChipa
SMS_HTTP_URL=
BEEM_APP_NAME=Selonachipa
BEEM_APP_ID=226405
# Approved Beem sender ID. Change to SeloNaChipa once Beem approves that sender name.
BEEM_SENDER_ID=Mabala
BEEM_OTP_BASE_URL=https://apiotp.beem.africa/v1
BEEM_SMS_BASE_URL=https://apisms.beem.africa/v1
BEEM_BALANCE_URL=https://apisms.beem.africa/public/v1/vendors/balance
BEEM_COUNTRY_CODES=260
BEEM_HEALTH_MODE=probe
BEEM_HEALTH_TEST_MSISDN=

# --- Lipila (mobile-money payments and payouts), production host
LIPILA_BASE_URL=https://blz.lipila.io
LIPILA_CALLBACK_URL=https://us-central1-mabala-f2d65.cloudfunctions.net/lipila_webhook
LIPILA_COLLECTION_PATH=/api/v1/collections/mobile-money
LIPILA_DISBURSEMENT_PATH=/api/v1/disbursements/mobile-money
LIPILA_COLLECTION_STATUS_PATH=/api/v1/collections/check-status?referenceId={referenceId}
# Not provided by Lipila yet: unconfirmed withdrawals go to manual review after the callback timeout.
LIPILA_DISBURSEMENT_STATUS_PATH=
LIPILA_LOOKUP_PATH=

# --- Listing Studio / AI
GEMINI_MODEL=gemini-2.5-flash
RUNWAY_MODEL=gen4.5
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Delivery tracking links
TRACKING_BASE_URL=https://mabala-f2d65.web.app/t/
