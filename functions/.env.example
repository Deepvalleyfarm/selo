# functions/.env.<projectId> — non-secret parameters (copy to .env.mabala-f2d65 and fill in). Never commit real values.
#
# SECRETS — do NOT put these in any .env file. Store them in Secret Manager:
#   firebase functions:secrets:set BEEM_API_KEY        # Beem API key
#   firebase functions:secrets:set BEEM_SECRET_KEY     # Beem secret key
#   firebase functions:secrets:set MAPS_API_KEY        # Google key restricted to Places API (New), Geocoding API, Routes API
#   firebase functions:secrets:set LIPILA_API_KEY          # Lipila live key
#   firebase functions:secrets:set LIPILA_WEBHOOK_SECRET   # Lipila webhook secret (base64 or whsec_…; space-separate two during rotation)
#   firebase functions:secrets:set GEMINI_API_KEY / DELIVERY_CODE_SECRET
#   firebase functions:secrets:set CLOUDINARY_URL          # cloudinary://<api_key>:<api_secret>@<cloud_name>
#   firebase functions:secrets:set DEEPGRAM_API_KEY / ELEVENLABS_API_KEY / RUNWAY_API_KEY

# --- Beem Africa (BEEM-OTP-001). Per application: change only these values.
BEEM_APP_NAME=Selonachipa            # Mabala: BEEM_APP_NAME=Mabala
BEEM_APP_ID=                         # OTP application ID from Beem portal → OTP → Applications
BEEM_SENDER_ID=                      # approved sender ID (e.g. the one registered for your account)
BEEM_OTP_BASE_URL=https://apiotp.beem.africa/v1
BEEM_SMS_BASE_URL=https://apisms.beem.africa/v1
BEEM_BALANCE_URL=https://apisms.beem.africa/public/v1/vendors/balance
BEEM_COUNTRY_CODES=260               # comma-separated supported country codes
BEEM_HEALTH_MODE=probe               # probe = no SMS sent (recommended) | send = real OTP to the test number every 5 min
BEEM_HEALTH_TEST_MSISDN=             # only for BEEM_HEALTH_MODE=send, e.g. 260977000000
SMS_PROVIDER=beem                    # beem | log (log = don't send, emulator/staging)

# --- Lipila (payments). Production host required — confirm with Lipila; there is deliberately no default.
LIPILA_BASE_URL=
LIPILA_CALLBACK_URL=https://us-central1-mabala-f2d65.cloudfunctions.net/lipila_webhook
LIPILA_MERCHANT_ID=1308
LIPILA_WEBHOOK_TOLERANCE_SECONDS=300
LIPILA_COLLECTION_PATH=/api/v1/collections/mobile-money
LIPILA_DISBURSEMENT_PATH=/api/v1/disbursements/mobile-money
LIPILA_COLLECTION_STATUS_PATH=       # e.g. /api/v1/collections/check-status?referenceId={referenceId}  (confirm with Lipila)
LIPILA_DISBURSEMENT_STATUS_PATH=     # without it, unconfirmed withdrawals go to manual review after the timeout
LIPILA_LOOKUP_PATH=                  # account-holder name lookup, if Lipila offers it

# --- Listing Studio
RUNWAY_MODEL=gen4.5
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Other parameters
GEMINI_MODEL=gemini-2.5-flash
TRACKING_BASE_URL=https://mabala-f2d65.web.app/t/
